{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "kbnetworking",
  "version-string": "0.1.0",
  "description": "Kablunk Networking library using Steam's GameNetworkingSockets",
  "dependencies": [
    "fmt",
    "gamenetworkingsockets",
    "libcoro",
    "msgpack",
    "pkgconf",
    "spdlog"
  ],
  "default-features": [
    "openssl"
  ],
  "features": {
    "examples": {
      "description": "Build the examples."
    },
    "libsodium": {
      "description": "Use libsodium as the crypto provider.",
      "dependencies": [
        "libsodium"
      ]
    },
    "openssl": {
      "description": "Use OpenSSL as the crypto provider.  This is the default.",
      "dependencies": [
        "openssl"
      ]
    },
    "tests": {
      "description": "Build the tests."
    },
    "tools": {
      "description": "Build cert management tool."
    },
    "webrtc": {
      "description": "Compiles WebRTC support for P2P.",
      "dependencies": [
        "abseil"
      ]
    }
  }
}
